{
  "name": "chunan-alumni-postcard",
  "version": "1.0.0",
  "private": true,
  "author": "淳安第三中学",
  "description": "淳安第三中学校友明信片制作终端",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5176 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5176 electron .\"",
    "check": "vue-tsc -b && node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/image-print.cjs && node --check electron/network-address.cjs",
    "test": "node --test electron/*.test.cjs",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4176",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "pinia": "3.0.4",
    "vue": "3.5.40"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "concurrently": "9.2.4",
    "cross-env": "7.0.3",
    "electron": "37.2.3",
    "electron-builder": "26.15.3",
    "typescript": "5.8.3",
    "vite": "7.3.6",
    "vue-tsc": "3.3.7",
    "wait-on": "8.0.3"
  },
  "build": {
    "appId": "cn.edu.chunan3.postcard",
    "productName": "淳安三中校友明信片",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "directories": {
      "output": "release"
    }
  }
}