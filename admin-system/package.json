{
  "name": "chunan-adminsystem",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "淳安第三中学展厅统一业务后台管理系统",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.mjs\" \"vite\"",
    "dev:server": "node --watch server/index.mjs",
    "dev:web": "vite",
    "start": "node server/index.mjs",
    "build": "vue-tsc -b && vite build",
    "check": "node --check server/index.mjs && node --check server/database.mjs && node --check server/network-address.mjs && node --check server/zip.mjs && vue-tsc -b",
    "test:review": "node --test server/review-flow.test.mjs",
    "test:postcard": "node --test server/postcard-flow.test.mjs",
    "test": "node --test server/*.test.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "pinia": "^3.0.4",
    "vue": "^3.5.39",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "concurrently": "^9.2.4",
    "typescript": "~5.8.3",
    "vite": "^7.3.6",
    "vue-tsc": "^3.3.7"
  }
}
