{
  "name": "chunan-signature-wall",
  "version": "1.0.0",
  "private": true,
  "description": "淳安第三中学展厅签名展示墙",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5175 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5175 electron .\"",
    "check": "vue-tsc -b && node --check electron/main.cjs",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "pinia": "^3.0.4",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12",
    "typescript": "~5.8.3",
    "vite": "^7.3.6",
    "vue-tsc": "^3.3.7",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "cn.edu.chunan3.signature-wall",
    "productName": "淳安三中签名展示墙",
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": { "target": "nsis" },
    "directories": { "output": "release" }
  }
}
